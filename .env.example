# ──────────────────────────────────────────────────────────────────────────
# Atlas backend — environment configuration
#
# Copy this file to `.env` and fill in real values for your deployment.
# `dotenvy` loads this at process start; missing keys fall back to the
# defaults shown.  Anything secret (passwords, service keys) MUST live in
# `.env` (which is gitignored), never in `.env.example`.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080
FRONTEND_URL=http://localhost:3000
RUST_LOG=info

# ── Session / token signing ──────────────────────────────────────────────
# Used to sign session cookies and (later) issued JWTs.  Generate with:
#   openssl rand -base64 48
# Rotate this value to force every active session to log out.
JWT_SECRET=change-me-32-bytes-or-more-please-replace

# ── Supabase ─────────────────────────────────────────────────────────────
# The platform persists organizations, users, and entity-level KYC in
# Supabase Postgres.  Row-Level Security (RLS) is expected to be enabled
# on every table — the backend uses the `service_role` key for admin
# operations and the `anon` key for user-context queries.
#
# Find these values in your Supabase project dashboard at:
#   Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key-from-supabase-dashboard
SUPABASE_SERVICE_ROLE_KEY=service-role-key-from-supabase-dashboard

# Direct Postgres connection used for migrations / batch jobs.
# Find under Settings → Database → Connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require

# ── Notes on RLS expectations ────────────────────────────────────────────
# When you enable RLS on Supabase tables, every query carrying an end-user
# JWT (the `anon` key + the user's bearer token) is automatically scoped
# to rows that satisfy the table's policies.  For Atlas this means:
#
#   - `users`: users may SELECT their own row; only service_role may INSERT.
#   - `organizations`: members may SELECT/UPDATE their org's row.
#   - `entities`, `sponsors`, `funds`: scoped by `organization_id` matching
#     the requesting user's org.
#
# Until the Supabase wiring is implemented, the backend keeps everything
# in an in-memory `RwLock` mirror of these tables (see `src/state.rs`).
